{
  "name": "@prodmind/app-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch dist/server.js",
    "start": "node dist/server.js",
    "lint": "node ../../scripts/lint.mjs --scope src",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/test-package.mjs --scope . --package @prodmind/app-web",
    "build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json && node -e \"const fs=require('fs');const path=require('path');const src='src/static';const dst='dist/static';if(fs.existsSync(src)){fs.mkdirSync(dst,{recursive:true});fs.readdirSync(src).forEach(f=>fs.copyFileSync(path.join(src,f),path.join(dst,f)));}\""

  },
  "dependencies": {
    "@prodmind/challenge-engine": "workspace:*",
    "@prodmind/decision-engine": "workspace:*",
    "@prodmind/asset-engine": "workspace:*",
    "@prodmind/shared-types": "workspace:*",
    "@prodmind/llm-adapter": "workspace:*",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0"
  },
  "exports": {
    ".": "./dist/index.js"
  }
}
